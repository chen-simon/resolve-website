---
import { mailingList, site } from '../config';

interface Props {
  /** List / tag identifier, e.g. "star-stations" */
  list: string;
  heading?: string;
}

const { list, heading = 'Get updates' } = Astro.props;
const id = `ml-${list}`;

// No provider yet → mailto fallback so the form still does something.
const hasProvider = mailingList.action !== '';
const action = hasProvider
  ? mailingList.action
  : `mailto:${site.email}?subject=${encodeURIComponent(`Mailing list: ${list}`)}`;
---

<form
  class="ml"
  action={action}
  method={mailingList.method}
  enctype={hasProvider ? undefined : 'text/plain'}
  data-list={list}
>
  <label class="label ml__heading" for={id}>{heading}</label>
  <div class="ml__row">
    <input
      id={id}
      class="ml__input"
      type="email"
      name={mailingList.emailField}
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    {Object.entries(mailingList.hidden).map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))}
    <button class="btn" type="submit">Sign up</button>
  </div>
  <p class="ml__status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  // Submit to provider in background so the visitor never sees its raw JSON response.
  document.querySelectorAll<HTMLFormElement>('form.ml').forEach((form) => {
    if (form.action.startsWith('mailto:')) return;
    const status = form.querySelector<HTMLParagraphElement>('.ml__status')!;
    const row = form.querySelector<HTMLDivElement>('.ml__row')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      status.hidden = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false) throw new Error();
        row.hidden = true;
        status.textContent = "You're on the list! Thanks for signing up.";
      } catch {
        button.disabled = false;
        status.textContent = 'Something went wrong. Please try again.';
      }
      status.hidden = false;
    });
  });
</script>

<style>
  .ml { display: grid; gap: var(--s-3); width: 100%; max-width: 30rem; }
  .ml__heading { opacity: 0.8; }
  .ml__row { display: flex; gap: var(--s-3); flex-wrap: wrap; }
  .ml__input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.8em 1em;
    border: 1px solid currentColor;
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .ml__input::placeholder { color: inherit; opacity: 0.5; }
  .ml__input:focus-visible { outline-offset: 2px; }
  .ml__row[hidden], .ml__status[hidden] { display: none; }
  .ml__status { margin: 0; }
</style>
