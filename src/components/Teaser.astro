---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MailingList from './MailingList.astro';

interface Props {
  game: CollectionEntry<'games'>;
  /** Link through to the game page (off when already on it) */
  showLink?: boolean;
  headingLevel?: 'h1' | 'h2';
  /** Game page for unreleased games: small blurb, sign-up CTA is the focus */
  minimal?: boolean;
}

const { game, showLink = true, headingLevel: H = 'h1', minimal = false } = Astro.props;
const { title, tagline, keyArt, mailingList } = game.data;
---

<section class:list={['teaser', { 'teaser--minimal': minimal }]} aria-labelledby={`teaser-${game.id}`}>
  <div class="teaser__stars" aria-hidden="true"></div>
  <div class="container teaser__inner">
    <p class="label teaser__meta">
      <span>Resolve presents</span>
      <span class="badge">Coming soon</span>
    </p>

    <H id={`teaser-${game.id}`} class="teaser__title">
      <Image src={keyArt} alt={title} widths={[360, 560, 860]} sizes="(max-width: 40rem) 80vw, 28rem" class="teaser__logo" loading="eager" />
    </H>

    {minimal && Astro.slots.has('default')
      ? <div class="teaser__tagline"><slot /></div>
      : <p class="teaser__tagline">{tagline}</p>}

    {mailingList && <MailingList list={game.id} heading="Save your spot for the beta" />}

    {showLink && (
      <a class="label teaser__more" href={`/games/${game.id}/`}>More about {title} →</a>
    )}
  </div>
</section>

<script>
  const teasers = document.querySelectorAll<HTMLElement>('.teaser');
  if (teasers.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;
    const update = () => {
      queued = false;
      teasers.forEach((t) => t.style.setProperty('--scroll', String(Math.max(0, -t.getBoundingClientRect().top))));
    };
    addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>

<style>
  .teaser {
    position: relative;
    overflow: hidden;
    /* Star Stations gets its own deep-space navy, not the site's flat black */
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, #1b2246 0%, transparent 70%),
      #0c0f1d;
    color: var(--c-space-ink);
  }

  /* Starfield: a few tiled layers of tiny radial dots, slowly drifting */
  .teaser__stars,
  .teaser__stars::after {
    position: absolute;
    inset: -50% 0 0 0;
    background-image:
      radial-gradient(2px 2px at 20px 30px, #fff 50%, transparent 51%),
      radial-gradient(2px 2px at 140px 80px, #fff 50%, transparent 51%),
      radial-gradient(3px 3px at 90px 160px, #fff 50%, transparent 51%),
      radial-gradient(2px 2px at 200px 220px, #fff 50%, transparent 51%),
      radial-gradient(2.5px 2.5px at 260px 40px, #fff 50%, transparent 51%);
    background-size: 300px 260px;
    opacity: 0.55;
    animation: drift 120s linear infinite;
    /* Scroll parallax via `translate`, so it stacks with the drift `transform` */
    translate: 0 calc(var(--scroll, 0) * 0.25px);
  }
  .teaser__stars::after {
    content: '';
    inset: 0;
    background-size: 470px 410px;
    opacity: 0.35;
    animation-duration: 200s;
    /* Nested in the near layer, so this adds on top: far stars lag more */
    translate: 0 calc(var(--scroll, 0) * 0.2px);
  }
  @keyframes drift { to { transform: translateY(260px); } }

  .teaser__inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-6);
    padding-block: var(--s-8) var(--s-9);
  }

  .teaser__meta {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    color: var(--c-space-soft);
  }

  .teaser__title { width: min(28rem, 80vw); }
  .teaser__logo { width: 100%; height: auto; }

  .teaser__tagline {
    max-width: 32rem;
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .teaser :global(.ml__heading) { justify-self: center; }

  /* Minimal: fills the screen, blurb shrinks, sign-up heading takes over */
  .teaser--minimal .teaser__inner {
    min-height: calc(100svh - 10rem);
    align-content: center;
    gap: var(--s-5);
    padding-block: var(--s-8);
  }
  /* Hero runs straight into the footer, no white strip */
  :global(body:has(.teaser--minimal) .footer) { margin-top: 0; }
  .teaser--minimal .teaser__title { width: min(20rem, 70vw); }
  .teaser--minimal .teaser__tagline {
    max-width: 34rem;
    font-size: var(--fs-md);
    line-height: 1.6;
    font-weight: 400;
    color: var(--c-space-soft);
  }
  .teaser--minimal :global(.ml) { max-width: 36rem; gap: var(--s-5); margin-top: var(--s-5); }
  .teaser--minimal :global(.ml__heading) {
    opacity: 1;
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .teaser__more {
    color: var(--c-space-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .teaser__more:hover { color: var(--c-accent); }
</style>
