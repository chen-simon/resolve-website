---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MailingList from './MailingList.astro';
import Parallax from './Parallax.astro';

interface Props {
  game: CollectionEntry<'games'>;
  /** Link through to the game page (off when already on it) */
  showLink?: boolean;
  headingLevel?: 'h1' | 'h2';
  /** Game page for unreleased games: small blurb, sign-up CTA is the focus */
  minimal?: boolean;
}

const { game, showLink = true, headingLevel: H = 'h1', minimal = false } = Astro.props;
const { title, tagline, keyArt, mailingList } = game.data;
---

<section class:list={['teaser', { 'teaser--minimal': minimal }]} aria-labelledby={`teaser-${game.id}`}>
  <div class="container teaser__inner">
    <p class="label teaser__meta">
      <span>Resolve presents</span>
      <span class="badge">Coming soon</span>
    </p>

    <H id={`teaser-${game.id}`} class="teaser__title">
      <Image src={keyArt} alt={title} widths={[360, 560, 860]} sizes="(max-width: 40rem) 80vw, 28rem" class="teaser__logo" loading="eager" />
    </H>

    {minimal && Astro.slots.has('default')
      ? <div class="teaser__tagline"><slot /></div>
      : <p class="teaser__tagline">{tagline}</p>}

    {mailingList && <MailingList list={game.id} heading="Save your spot for the beta" />}

    {showLink && (
      <a class="label teaser__more" href={`/games/${game.id}/`}>More about {title} →</a>
    )}
  </div>
  <Parallax game={game.id} />
</section>

<style>
  .teaser {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Star Stations gets its own deep-space navy, not the site's flat black */
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, #1b2246 0%, transparent 70%),
      #0c0f1d;
    color: var(--c-space-ink);
  }

  .teaser__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-6);
    padding-block: var(--s-8) var(--s-9);
  }
  /* With key art, the scene's spacer supplies the bottom room */
  .teaser:has(:global(.scene)) .teaser__inner { padding-bottom: var(--s-5); }

  .teaser__meta {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    color: var(--c-space-soft);
  }

  .teaser__title { width: min(28rem, 80vw); }
  .teaser__logo { width: 100%; height: auto; }

  .teaser__tagline {
    max-width: 32rem;
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .teaser :global(.ml__heading) { justify-self: center; }
  /* Keep the field solid over the key art drifting behind it */
  .teaser :global(.ml__input) { background: rgb(12 15 29 / 0.75); backdrop-filter: blur(6px); }

  /* Minimal: fills the screen, blurb shrinks, sign-up heading takes over */
  .teaser--minimal { min-height: calc(100svh - 4rem); }
  .teaser--minimal .teaser__inner {
    flex: 1;
    align-content: center;
    gap: var(--s-5);
    padding-top: var(--s-8);
  }
  /* Hero runs straight into the footer, no white strip */
  :global(body:has(.teaser--minimal) .footer) { margin-top: 0; }
  .teaser--minimal .teaser__title { width: min(20rem, 70vw); }
  .teaser--minimal .teaser__tagline {
    max-width: 34rem;
    font-size: var(--fs-md);
    line-height: 1.6;
    font-weight: 400;
    color: var(--c-space-soft);
  }
  .teaser--minimal :global(.ml) { max-width: 36rem; gap: var(--s-5); margin-top: var(--s-5); }
  .teaser--minimal :global(.ml__heading) {
    opacity: 1;
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .teaser__more {
    color: var(--c-space-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .teaser__more:hover { color: var(--c-accent); }
</style>
